<Project>

  <!--
    Repository-wide build settings.
    Every project inherits these; project files carry only what is genuinely
    project-specific. See docs/architecture/architecture-rules.md.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      Globalisation stays on. conventions.md section 2.2 requires that a branch's IANA timezone is resolved
      through a tz-database-backed API and that a fixed +05:30 offset is never hard-coded. Invariant
      globalisation drops the ICU data that maps an IANA identifier on Windows, so `Asia/Kolkata` fails to
      resolve there and `IndiaTimeZone.Instance` throws in its static initialiser — taking the host with it.
      The runtime images are Debian-based `mcr.microsoft.com/dotnet/aspnet`, which carry ICU already.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <NoWarn>$(NoWarn);CA1848;CA2007</NoWarn>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <AssemblyName>$(MSBuildProjectName)</AssemblyName>
    <Product>HyFib Tailor360</Product>
    <Company>HyFib</Company>
  </PropertyGroup>

  <!-- Test projects opt in to the test SDK and the shared test conventions. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <!-- xUnit v3 runs on Microsoft.Testing.Platform; .NET 10's `dotnet test` needs this opt-in. -->
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

</Project>
