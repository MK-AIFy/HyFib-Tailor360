# .NET
bin/
obj/
*.user
*.suo
artifacts/
TestResults/
coverage/
*.trx
*.coverage
*.received.*

# Node
node_modules/
dist/
dist-ssr/
.vite/
*.tsbuildinfo
playwright-report/
test-results/
blob-report/
.pnpm-store/

# Environment and secrets — never commit real values
.env
.env.*
!.env.example
secrets/
*.pfx
*.key
!tests/**/*.test.key

# Editors and OS
.vs/
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# The built client is copied into the web host's wwwroot by the image build and by scripts/dev.
# It is build output, not source.
src/Hosts/Tailor360.Web/wwwroot/*
!src/Hosts/Tailor360.Web/wwwroot/.gitkeep

# Local infrastructure state
infra/compose/data/

# Python bytecode from the repository's own helper scripts.
__pycache__/
*.py[cod]
