{
  // Application code. Vite does the transpilation, TypeScript only type-checks, hence noEmit.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "useDefineForClassFields": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // Keeps the source free of TypeScript-only runtime constructs (enums, parameter properties) that a
    // type-stripping runtime cannot execute.
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "skipLibCheck": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedSideEffectImports": true,
    "exactOptionalPropertyTypes": true
  },
  // .storybook/preview.tsx carries JSX and imports application code, so it belongs to the browser
  // project rather than the Node one. ESLint resolves types through the project service, and a file
  // in no project is a parse error, not a lint warning.
  "include": ["src", ".storybook/preview.tsx"]
}
