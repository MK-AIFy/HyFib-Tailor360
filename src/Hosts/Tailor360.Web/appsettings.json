{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "Secrets": {
    "Directory": "/run/secrets"
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Security": {
    "StepUp": {
      "Freshness": "00:05:00"
    }
  },
  "Observability": {
    "ServiceName": "tailor360-web",
    "OtlpEndpoint": "",
    "TraceSamplingRatio": 0.1
  },
  "AllowedHosts": "*",
  "Database": {
    "ConnectionString": "",
    "MaxPoolSize": 20,
    "ServerMaxConnections": 100,
    "ReservedConnections": 20,
    "ExpectedProcessCount": 2,
    "CommandTimeoutSeconds": 30
  },
  "Idempotency": {
    "MaximumOfflineQueueAge": "3.00:00:00"
  },
  "FeatureFlags": {
    "PropagationBound": "00:00:30"
  },
  "Outbox": {
    "BatchSize": 20,
    "IdlePollInterval": "00:00:02",
    "LeaseDuration": "00:02:00",
    "MaximumAttempts": 8,
    "RetryBaseDelay": "00:00:05",
    "RetryMaximumDelay": "00:10:00",
    "BacklogWarningAge": "00:02:00"
  }
}
