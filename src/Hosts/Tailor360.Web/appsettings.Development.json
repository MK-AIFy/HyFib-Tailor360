{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information"
      }
    }
  },
  "Secrets": {
    "Directory": "./secrets"
  },
  "ForwardedHeaders": {
    "KnownNetworks": [
      "127.0.0.1/8"
    ]
  },
  "Observability": {
    "ServiceName": "tailor360-web-dev",
    "TraceSamplingRatio": 1.0
  },
  "Database": {
    "ConnectionString": "Host=127.0.0.1;Port=5433;Username=postgres;Database=tailor360_dev",
    "MaxPoolSize": 10,
    "ExpectedProcessCount": 2
  }
}
