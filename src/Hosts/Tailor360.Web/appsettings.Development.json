{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information"
      }
    }
  },
  "Secrets": {
    "Directory": "./secrets"
  },
  "ObjectStorage": {
    "Endpoint": "http://127.0.0.1:9000"
  },
  "ForwardedHeaders": {
    "KnownNetworks": [
      "127.0.0.1/8"
    ]
  },
  "Identity": {
    "Recovery": {
      "PublicBaseUrl": "http://127.0.0.1:5173",
      "AllowInsecurePublicBaseUrl": true
    }
  },
  "Observability": {
    "ServiceName": "tailor360-web-dev",
    "TraceSamplingRatio": 1.0
  },
  "Database": {
    "ConnectionString": "Host=127.0.0.1;Port=5432;Database=tailor360;Username=tailor360;Password=tailor360_dev_only",
    "MaxPoolSize": 10,
    "ExpectedProcessCount": 2
  }
}
