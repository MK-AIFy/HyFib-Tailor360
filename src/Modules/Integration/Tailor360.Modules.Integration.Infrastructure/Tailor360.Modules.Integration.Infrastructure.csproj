<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="QuestPDF" />
    <PackageReference Include="ZXing.Net" />
    <PackageReference Include="Minio" />
    <!--
      SkiaSharp brings its Windows and macOS native binaries itself; Linux needs its own package (#597).
      The hosts publish without a runtime identifier, so every platform's binary lands in the Linux
      images too; trimming that is #644.
    -->
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
  </ItemGroup>

  <ItemGroup>
    <!-- The document fonts, under the SIL Open Font License beside them (ADR-0014). -->
    <EmbeddedResource Include="Fonts\NotoSans.ttf" />
    <EmbeddedResource Include="Fonts\NotoSansTamil.ttf" />
    <None Include="Fonts\OFL.txt" />
  </ItemGroup>

  <ItemGroup>
    <!--
      QuestPdfRenderer.StabiliseFileIdentifier pins the random file identifier PDF/UA makes QuestPDF write.
      Which of PDF's two string serialisations that identifier arrives in is a property of the random bytes,
      so the rendering tests reach one arm about once in a hundred runs and the other almost always (#568).
      Exposed to the contract tier, which already owns this renderer's determinism, so both arms are proved
      from a fixed input rather than waited for. Internal rather than public so the boundary still holds.
    -->
    <InternalsVisibleTo Include="Tailor360.ContractTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tailor360.Modules.Integration.Application\Tailor360.Modules.Integration.Application.csproj" />
    <ProjectReference Include="..\..\..\Platform\Tailor360.Platform.Observability\Tailor360.Platform.Observability.csproj" />
    <ProjectReference Include="..\..\..\Platform\Tailor360.Platform.Persistence\Tailor360.Platform.Persistence.csproj" />
  </ItemGroup>

</Project>
